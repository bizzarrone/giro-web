# Sicurezza (tutte le pagine). La CSP è in modalità Report-Only: non blocca nulla, segnala in console cosa violerebbe.
# Quando la console resta pulita per qualche giorno → rinominare in "Content-Security-Policy".
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(self), payment=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdnjs.cloudflare.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https:; worker-src 'self' blob:; child-src blob:; frame-src https://girocalendar.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/sw.js
  Cache-Control: no-cache

/*.js
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
